<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

        <!-- Main Screen Content (Now Playing) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_content_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="56dp">

            <!-- Top Bar -->
            <TextView
                android:id="@+id/app_title_text"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical|start"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                app:layout_constraintEnd_toStartOf="@id/btn_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintBottom_toBottomOf="@id/app_title_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/app_title_text"
            app:tint="@color/text_primary" />

        <!-- Peek Album Art Card (Revealed behind during swipe) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/peek_album_art_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/surface_container"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="@id/album_art_card"
            app:layout_constraintBottom_toBottomOf="@id/album_art_card"
            app:layout_constraintStart_toStartOf="@id/album_art_card"
            app:layout_constraintEnd_toEndOf="@id/album_art_card">

            <ImageView
                android:id="@+id/peek_album_art_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Peek Album Art"
                android:scaleType="centerCrop"
                android:src="@drawable/default_album_art" />

            <LinearLayout
                android:id="@+id/peek_badge_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/peek_label_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_accent"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true"
                    tools:text="NEXT TRACK" />

                <TextView
                    android:id="@+id/peek_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Song Title" />

                <TextView
                    android:id="@+id/peek_artist_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Artist Name" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lyrics Card (Revealed behind during slide-up) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lyrics_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="invisible"
            app:cardCornerRadius="24dp"
            app:cardElevation="7dp"
            app:cardBackgroundColor="@color/surface_container"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="@id/album_art_card"
            app:layout_constraintBottom_toBottomOf="@id/album_art_card"
            app:layout_constraintStart_toStartOf="@id/album_art_card"
            app:layout_constraintEnd_toEndOf="@id/album_art_card">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lyrics_content_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Header Bar -->
                <LinearLayout
                    android:id="@+id/lyrics_header_bar"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/lyrics_title_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LYRICS"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/lyrics_source_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_material_you"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="LRCLIB"
                        android:textColor="@color/primary_accent"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Close Lyrics Button -->
                    <ImageButton
                        android:id="@+id/btn_close_lyrics"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close Lyrics"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Synced Lyrics RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lyrics_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:clipToPadding="false"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="32dp"
                    app:layout_constraintTop_toBottomOf="@id/lyrics_header_bar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Plain Lyrics ScrollView -->
                <ScrollView
                    android:id="@+id/lyrics_plain_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="32dp"
                    app:layout_constraintTop_toBottomOf="@id/lyrics_header_bar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/lyrics_plain_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="sans-serif" />
                </ScrollView>

                <!-- Status Layout (Loading / Instrumental / Not Found / Error) -->
                <LinearLayout
                    android:id="@+id/lyrics_status_layout"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/lyrics_header_bar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ProgressBar
                        android:id="@+id/lyrics_progress_bar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary_accent" />

                    <ImageView
                        android:id="@+id/lyrics_status_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_music_note"
                        android:visibility="gone"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/lyrics_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Loading lyrics..."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lyrics_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:text="Retry"
                        android:visibility="gone"
                        android:textSize="12sp"
                        android:textColor="@color/on_primary"
                        app:backgroundTint="@color/primary_accent"
                        app:cornerRadius="18dp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Album Art Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/album_art_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/album_art_margin_horizontal"
            android:layout_marginTop="@dimen/album_art_margin_top"
            android:layout_marginEnd="@dimen/album_art_margin_horizontal"
            android:layout_marginBottom="@dimen/album_art_margin_bottom"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface_container"
            app:strokeWidth="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_max="@dimen/album_art_max_size"
            app:layout_constraintWidth_max="@dimen/album_art_max_size"
            app:layout_constraintBottom_toTopOf="@id/song_title_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_title_text"
            app:layout_constraintVertical_bias="0.5">

            <ImageView
                android:id="@+id/album_art_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album Art"
                android:scaleType="centerCrop"
                android:src="@drawable/default_album_art" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Song Metadata -->
        <TextView
            android:id="@+id/song_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="@dimen/song_title_margin_top"
            android:layout_marginEnd="32dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="@string/no_track_selected"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/song_title_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/album_art_card" />

        <TextView
            android:id="@+id/artist_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="32dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/artist_name_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/song_title_text" />

        <TextView
            android:id="@+id/album_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="32dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/album_name_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/artist_name_text" />

        <!-- Title Gesture Area (Double tap to seek 5s, or slide right to open left menu) -->
        <View
            android:id="@+id/title_gesture_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="-12dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="false"
            app:layout_constraintTop_toBottomOf="@id/album_art_card"
            app:layout_constraintBottom_toBottomOf="@id/album_name_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Double Tap Seek Feedback Badges in Title Area (Text-only +5 / -5) -->
        <TextView
            android:id="@+id/title_seek_badge_rewind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_video_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="-5"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/song_title_text"
            app:layout_constraintBottom_toBottomOf="@id/album_name_text" />

        <TextView
            android:id="@+id/title_seek_badge_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_video_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="+5"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/song_title_text"
            app:layout_constraintBottom_toBottomOf="@id/album_name_text" />

        <!-- Material You Audio Info Badges (e.g. FLAC, 16bit/192khz, HI-RES) -->
        <LinearLayout
            android:id="@+id/audio_badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/track_details"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/album_name_text">

            <TextView
                android:id="@+id/badge_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_material_you"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="FLAC"
                android:textColor="@color/primary_accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badge_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_material_you"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="16bit/192khz"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badge_hires"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_hires"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Hi-Res"
                android:textColor="#F6C445"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badge_bit_perfect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_bit_perfect"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="bit perfect"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:visibility="gone" />


            <TextView
                android:id="@+id/badge_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_material_you"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="10ms"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Android 13/14 Squiggly Progress Line Seek Bar -->
        <xyz.omniplay.ui.SquigglySeekBar
            android:id="@+id/playback_slider"
            android:layout_width="0dp"
            android:layout_height="@dimen/playback_slider_height"
            android:layout_marginStart="24dp"
            android:layout_marginTop="@dimen/playback_slider_margin_top"
            android:layout_marginEnd="24dp"
            android:enabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/audio_badge_container" />

        <!-- Timestamps positioned below waveform slider -->
        <TextView
            android:id="@+id/current_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="@dimen/time_margin_top"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/default_time"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/total_time_text"
            app:layout_constraintTop_toBottomOf="@id/playback_slider" />

        <TextView
            android:id="@+id/total_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="@dimen/time_margin_top"
            android:text="@string/default_time"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playback_slider" />

        <!-- Playback Controls -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controls_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="@dimen/controls_margin_top"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="@dimen/controls_margin_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/current_time_text"
            app:layout_constraintVertical_bias="0.0">

            <!-- Shuffle -->
            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shuffle"
                android:padding="10dp"
                android:src="@drawable/ic_shuffle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_previous"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/control_tint" />

            <!-- Previous -->
            <ImageButton
                android:id="@+id/btn_previous"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/skip_previous"
                android:padding="12dp"
                android:src="@drawable/ic_skip_previous"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_play_pause_card"
                app:layout_constraintStart_toEndOf="@id/btn_shuffle"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_primary" />

            <!-- Play / Pause Circular Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_play_pause_card"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:cardBackgroundColor="@color/primary_accent"
                app:cardCornerRadius="33dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_next"
                app:layout_constraintStart_toEndOf="@id/btn_previous"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btn_play_pause_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/play"
                    android:src="@drawable/ic_play"
                    app:tint="@color/on_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Next -->
            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/skip_next"
                android:padding="12dp"
                android:src="@drawable/ic_skip_next"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_repeat"
                app:layout_constraintStart_toEndOf="@id/btn_play_pause_card"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_primary" />

            <!-- Repeat -->
            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/repeat"
                android:padding="10dp"
                android:src="@drawable/ic_repeat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_next"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/control_tint" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom section after playback controls to capture swipe-up gesture to open playlist -->
        <View
            android:id="@+id/bottom_gesture_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="false"
            app:layout_constraintTop_toBottomOf="@id/controls_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Persistent In-Window Sliding Playlist Panel -->
    <LinearLayout
        android:id="@+id/playlist_sliding_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="56dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Sliding Panel Peek Header (Draggable & Clickable) -->
        <LinearLayout
            android:id="@+id/playlist_peek_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iv_chevron"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/expand_queue"
                android:src="@drawable/ic_expand_less"
                app:tint="@color/control_tint" />

            <TextView
                android:id="@+id/sheet_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/queue_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/song_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                tools:text="0 songs" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_container" />

        <!-- In-Window Playlist Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/songs_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <!-- Empty State View inside the panel -->
        <LinearLayout
            android:id="@+id/empty_state_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_music_note"
                app:tint="@color/control_tint" />

            <TextView
                android:id="@+id/empty_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/no_songs_found"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_folder_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/primary_accent"
                android:text="@string/select_folder"
                android:textColor="@color/on_primary"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrim for Left Filter Menu -->
    <View
        android:id="@+id/filter_drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Left Side Menu for Filter Library Only -->
    <LinearLayout
        android:id="@+id/left_drawer_menu"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_dark"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_container_high"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/primary_accent" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/drawer_subtitle_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="0 songs" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_drawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Menu"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/control_tint" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_container" />

        <!-- Filter Toggle Group: Album, Track, Artist -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filter_toggle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            app:checkedButton="@id/btn_filter_tracks"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_tracks"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/filter_tracks"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_artists"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/filter_artists"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter_albums"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/filter_albums"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Active Filter Banner (Visible when a specific Artist/Album is selected) -->
        <LinearLayout
            android:id="@+id/active_filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_badge_material_you"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/active_filter_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/primary_accent"
                android:textSize="12sp"
                tools:text="Filter: Artist • Queen" />

            <ImageButton
                android:id="@+id/btn_clear_filter"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear_filter"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/primary_accent" />
        </LinearLayout>

        <!-- Filter Mode Description / Stats -->
        <TextView
            android:id="@+id/drawer_filter_info_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="sans-serif"
            android:text="Showing all tracks"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <!-- Dynamic Filter Sub-List (Artists or Albums) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_filter_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="16dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
