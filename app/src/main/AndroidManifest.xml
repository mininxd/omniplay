<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for Audio Files -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Foreground Playback & Notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:targetApi="upside_down_cake" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Local Network & Offline Acoustic Mesh -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:name=".OmniplayApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Omniplay"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Dedicated Audio Player: Opened via file manager or Open With intents -->
        <activity
            android:name=".ui.AudioPlayerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Omniplay"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            tools:ignore="LockedOrientationActivity">

            <!-- Primary audio handler for file managers & content providers (content, file, http, https) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Universal audio MIME type without scheme constraint -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Additional MIME types used for audio by file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- MIME types without scheme constraint -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>

            <!-- Direct file extension matching for schemes without MIME type (or when MIME type is not set) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\..*\\.flac" />
                <data android:pathPattern=".*\\.FLAC" />
                <data android:pathPattern=".*\\..*\\.FLAC" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\..*\\.mp3" />
                <data android:pathPattern=".*\\.MP3" />
                <data android:pathPattern=".*\\..*\\.MP3" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\..*\\.wav" />
                <data android:pathPattern=".*\\.WAV" />
                <data android:pathPattern=".*\\..*\\.WAV" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\..*\\.m4a" />
                <data android:pathPattern=".*\\.M4A" />
                <data android:pathPattern=".*\\..*\\.M4A" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\..*\\.aac" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\..*\\.ogg" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\..*\\.opus" />
                <data android:pathPattern=".*\\.dsf" />
                <data android:pathPattern=".*\\..*\\.dsf" />
                <data android:pathPattern=".*\\.dff" />
                <data android:pathPattern=".*\\..*\\.dff" />
                <data android:pathPattern=".*\\.aiff" />
                <data android:pathPattern=".*\\..*\\.aiff" />
                <data android:pathPattern=".*\\.ape" />
                <data android:pathPattern=".*\\..*\\.ape" />
                <data android:pathPattern=".*\\.wma" />
                <data android:pathPattern=".*\\..*\\.wma" />
            </intent-filter>

            <!-- File managers that pass mimeType="*/*" with extension -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\..*\\.flac" />
                <data android:pathPattern=".*\\.FLAC" />
                <data android:pathPattern=".*\\..*\\.FLAC" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\..*\\.mp3" />
                <data android:pathPattern=".*\\.MP3" />
                <data android:pathPattern=".*\\..*\\.MP3" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\..*\\.wav" />
                <data android:pathPattern=".*\\.WAV" />
                <data android:pathPattern=".*\\..*\\.WAV" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\..*\\.m4a" />
                <data android:pathPattern=".*\\.M4A" />
                <data android:pathPattern=".*\\..*\\.M4A" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\..*\\.aac" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\..*\\.ogg" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\..*\\.opus" />
                <data android:pathPattern=".*\\.dsf" />
                <data android:pathPattern=".*\\..*\\.dsf" />
                <data android:pathPattern=".*\\.dff" />
                <data android:pathPattern=".*\\..*\\.dff" />
                <data android:pathPattern=".*\\.aiff" />
                <data android:pathPattern=".*\\..*\\.aiff" />
                <data android:pathPattern=".*\\.ape" />
                <data android:pathPattern=".*\\..*\\.ape" />
                <data android:pathPattern=".*\\.wma" />
                <data android:pathPattern=".*\\..*\\.wma" />
            </intent-filter>
        </activity>

        <!-- Hidden Video Player: Opened only via file manager or Open With intents -->
        <activity
            android:name=".ui.VideoPlayerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Omniplay.VideoPlayer"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTask">

            <!-- Primary video handler for file managers & content providers (content, file, http, https) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Universal video MIME type without scheme constraint -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Additional MIME types used for video by file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/matroska" />
                <data android:mimeType="application/mp4" />
            </intent-filter>

            <!-- MIME type without scheme for octet-stream and matroska -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-matroska" />
                <data android:mimeType="application/matroska" />
                <data android:mimeType="application/mp4" />
            </intent-filter>

            <!-- Direct file extension matching for schemes without MIME type (or when MIME type is not set) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\..*\\.mp4" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\..*\\.mkv" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\..*\\.webm" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\..*\\.MP4" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\..*\\.MKV" />
                <data android:pathPattern=".*\\.WEBM" />
                <data android:pathPattern=".*\\.3GP" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\.FLV" />
                <data android:pathPattern=".*\\.TS" />
                <data android:pathPattern=".*\\.M4V" />
                <data android:pathPattern=".*\\.WMV" />
            </intent-filter>

            <!-- File managers that pass mimeType="*/*" with extension -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\..*\\.mp4" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\..*\\.mkv" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\..*\\.webm" />
                <data android:pathPattern=".*\\.3gp" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.wmv" />
                <data android:pathPattern=".*\\.MP4" />
                <data android:pathPattern=".*\\.MKV" />
                <data android:pathPattern=".*\\.WEBM" />
                <data android:pathPattern=".*\\.3GP" />
                <data android:pathPattern=".*\\.MOV" />
                <data android:pathPattern=".*\\.AVI" />
                <data android:pathPattern=".*\\.FLV" />
                <data android:pathPattern=".*\\.TS" />
                <data android:pathPattern=".*\\.M4V" />
                <data android:pathPattern=".*\\.WMV" />
            </intent-filter>
        </activity>

        <!-- Media Playback Service -->
        <service
            android:name=".service.PlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            tools:targetApi="29" />

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
