        android:pathData="M80,220 Q120,200 160,260 Q180,340 100,340 Q50,300 80,220 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="80"
                android:startY="220"
                android:endX="180"
                android:endY="340"
                android:type="linear">
                <item android:color="#B338D9D6" android:offset="0.0" />
                <item android:color="#0038D9D6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- C A C I ' M Stylized Letters -->
    <!-- 'C' -->
    <path
        android:pathData="M130,175 C118,175 110,185 110,197 C110,210 118,220 130,220 C138,220 143,215 146,210 L140,206 C138,210 134,213 130,213 C122,213 118,206 118,197 C118,189 122,182 130,182 C134,182 138,185 140,189 L146,185 C143,180 138,175 130,175 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- 'A' (inverted chevron style) -->
    <path
        android:pathData="M165,175 L155,220 L163,220 L166,204 L179,204 L182,220 L190,220 L180,175 Z M172,185 L177,198 L168,198 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- 'C' -->
    <path
        android:pathData="M210,175 C198,175 190,185 190,197 C190,210 198,220 210,220 C218,220 223,215 226,210 L220,206 C218,210 214,213 210,213 C202,213 198,206 198,197 C198,189 202,182 210,182 C214,182 218,185 220,189 L226,185 C223,180 218,175 210,175 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- 'I' -->
    <path
        android:pathData="M233,176 H240 V220 H233 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- ''' apostrophe -->
    <path
        android:pathData="M244,174 L248,174 L246,183 L243,183 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- 'M' -->
    <path
        android:pathData="M253,176 H261 L268,198 L275,176 H283 V220 H276 V189 L270,208 H266 L260,189 V220 H253 Z"
