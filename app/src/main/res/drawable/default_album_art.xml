    <!-- Card Background with Material You Gradient -->
    <path
        android:pathData="M0,0h400v400h-400z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="400"
                android:endY="400"
                android:type="linear">
                <item android:color="#FF1A1C24" android:offset="0.0" />
                <item android:color="#FF14161F" android:offset="0.5" />
                <item android:color="#FF0D0E14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vinyl Outer Ring -->
    <path
        android:pathData="M200,200m-155,0a155,155 0 1,0 310,0a155,155 0 1,0 -310,0"
        android:fillColor="#FF181A22" />

    <!-- Vinyl Groove 1 -->
    <path
        android:pathData="M200,200m-140,0a140,140 0 1,0 280,0a140,140 0 1,0 -280,0"
        android:strokeColor="#1FFFFFFF"
        android:strokeWidth="1.5" />

