<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="400dp"
    android:viewportWidth="400"
    android:viewportHeight="400">

    <!-- Background Base with subtle gradient -->
    <path
        android:pathData="M0,0h400v400h-400z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="400"
                android:endY="400"
                android:type="linear">
                <item android:color="#FFD4E5FF" android:offset="0.0" />
                <item android:color="#FFE8B4D8" android:offset="0.4" />
                <item android:color="#FF8AD4E8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vibrant Central Neon Box -->
    <path
        android:pathData="M150,100h100v100h-100z"
        android:fillColor="#FF23D2E2" />

    <!-- Magenta overlay glow -->
    <path
        android:pathData="M120,110 Q200,80 250,160 Q260,250 180,260 Q100,240 120,110 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="120"
                android:startY="100"
                android:endX="260"
                android:endY="260"
                android:type="linear">
                <item android:color="#FFFF1493" android:offset="0.0" />
                <item android:color="#FF8A2BE2" android:offset="0.6" />
                <item android:color="#001E90FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized Portrait Silhouette -->
    <path
        android:pathData="M165,105 Q175,90 200,95 Q220,100 215,125 Q212,138 200,145 Q215,160 235,180 Q245,210 240,245 L155,245 Q150,210 162,180 Q170,165 178,145 Q168,135 165,105 Z"
