<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Default Material You Expressive dynamic theme -->
    <style name="Theme.Omniplay" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.Omniplay.VideoPlayer" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <!-- Theme Overlays for Dynamic Theme Styles -->
    <style name="ThemeOverlay.Omniplay.Tone" parent="">
        <item name="colorPrimary">@color/theme_tone_primary</item>
        <item name="colorOnPrimary">@color/theme_tone_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_tone_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_tone_on_primary_container</item>
    </style>

    <style name="ThemeOverlay.Omniplay.Expressive" parent="">
        <item name="colorPrimary">@color/theme_expressive_primary</item>
        <item name="colorOnPrimary">@color/theme_expressive_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_expressive_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_expressive_on_primary_container</item>
    </style>

    <style name="ThemeOverlay.Omniplay.Salad" parent="">
        <item name="colorPrimary">@color/theme_salad_primary</item>
        <item name="colorOnPrimary">@color/theme_salad_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_salad_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_salad_on_primary_container</item>
    </style>

    <style name="ThemeOverlay.Omniplay.Monochrome" parent="">
        <item name="colorPrimary">@color/theme_monochrome_primary</item>
        <item name="colorOnPrimary">@color/theme_monochrome_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_monochrome_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_monochrome_on_primary_container</item>
    </style>

    <style name="ThemeOverlay.Omniplay.Vibrant" parent="">
        <item name="colorPrimary">@color/theme_vibrant_primary</item>
        <item name="colorOnPrimary">@color/theme_vibrant_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_vibrant_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_vibrant_on_primary_container</item>
    </style>

    <!-- Split Button Shapes for Settings and Switches -->
    <style name="ShapeAppearance.Omniplay.SplitLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeTopRight">6dp</item>
        <item name="cornerSizeBottomRight">6dp</item>
    </style>

    <style name="ShapeAppearance.Omniplay.SplitRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">6dp</item>
        <item name="cornerSizeBottomLeft">6dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>
</resources>
