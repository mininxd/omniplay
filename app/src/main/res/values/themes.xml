<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 base; the user's selected color scheme supplies the theme personality. -->
    <style name="Theme.Omniplay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
        <item name="popupMenuStyle">@style/Widget.Omniplay.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Omniplay.PopupMenu</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">?attr/isLightTheme</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="Theme.Omniplay.VideoPlayer" parent="Theme.Material3.Dark.NoActionBar">
