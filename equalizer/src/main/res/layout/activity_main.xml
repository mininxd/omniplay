<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="20dp"
            app:contentInsetStartWithNavigation="0dp"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.Equalizer.Toolbar.Title"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitleTextAppearance="@style/TextAppearance.Equalizer.Toolbar.Subtitle"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/settings_title"
                app:icon="@drawable/ic_settings"
                app:iconTint="?attr/colorOnSurfaceVariant" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="48dp">

            <!-- Master Toggle (OmniPlay Style) -->
            <LinearLayout
                android:id="@+id/card_master_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_master_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tv_master_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/equalizer_master_switch"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_master"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:thumbIcon="@drawable/asl_switch_thumb" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.12"
                android:background="?attr/colorOutlineVariant" />

            <!-- SECTION 1: 10-Band Graphic Equalizer Studio Rack -->
            <LinearLayout
                android:id="@+id/card_dax_equalizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dax_equalizer_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/dax_equalizer_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_dax"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/reset_to_flat"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="?attr/colorPrimary"
                        app:tooltipText="@string/reset_to_flat" />
                </LinearLayout>

                <xyz.omniplay.equalizer.ui.DaxEqualizerBarsView
                    android:id="@+id/dax_eq_bars_view"
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Presets Section (Directly BOTTOM of EQ) -->
            <LinearLayout
                android:id="@+id/card_presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="4dp">

                <HorizontalScrollView
                    android:id="@+id/scroll_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.12"
                android:background="?attr/colorOutlineVariant" />

            <!-- SECTION 2: Intelligent Equalizer (IEQ - OmniPlay style without overflow) -->
            <LinearLayout
                android:id="@+id/card_ieq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/ieq_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.75"
                    android:text="@string/ieq_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_ieq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ieq_off"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/ieq_off"
                            app:chipEndPadding="6dp"
                            app:chipStartPadding="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ieq_balanced"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/ieq_balanced"
                            app:chipEndPadding="6dp"
                            app:chipStartPadding="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ieq_warm"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/ieq_warm"
                            app:chipEndPadding="6dp"
                            app:chipStartPadding="6dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ieq_detailed"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="@string/ieq_detailed"
                            app:chipEndPadding="6dp"
                            app:chipStartPadding="6dp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.12"
                android:background="?attr/colorOutlineVariant" />

            <!-- SECTION 3: Sub-Bass -->
            <LinearLayout
                android:id="@+id/card_clear_bass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/clear_bass_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/clear_bass_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_clear_bass_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0 dB"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_clear_bass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="-10"
                    android:valueTo="10"
                    app:tickVisible="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.12"
                android:background="?attr/colorOutlineVariant" />

            <!-- SECTION 4: Loudness Enhancer -->
            <LinearLayout
                android:id="@+id/card_loudness_enhancer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/row_loudness_enhancer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/loudness_enhancer_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/loudness_enhancer_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_loudness_enhancer_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/effect_off"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_loudness_enhancer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:thumbIcon="@drawable/asl_switch_thumb" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_loudness_enhancer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:stepSize="0.1"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="10.0"
                    app:tickVisible="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.12"
                android:background="?attr/colorOutlineVariant" />

            <!-- SECTION 5: Volume Boost -->
            <LinearLayout
                android:id="@+id/card_volume_boost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/row_xloud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/xloud_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/xloud_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_xloud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:thumbIcon="@drawable/asl_switch_thumb" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.12"
                android:background="?attr/colorOutlineVariant" />

            <!-- SECTION 6: Spatial & Playback Controls (Clean cardless controls without placeholder text) -->
            <LinearLayout
                android:id="@+id/card_playback_effects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <!-- Crossfeed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/crossfeed_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/crossfeed_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_crossfeed_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Off"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_crossfeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:stepSize="5"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:tickVisible="false" />

                <!-- Dynamic Range Control -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dynamic_range_control_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/dynamic_range_control_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_dynamic_range_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Off"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_dynamic_range"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:stepSize="5"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:tickVisible="false" />

                <!-- Mono Audio -->
                <LinearLayout
                    android:id="@+id/row_mono_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/mono_audio_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/mono_audio_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_mono_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        app:thumbIcon="@drawable/asl_switch_thumb" />
                </LinearLayout>

                <!-- Stereo Balance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/stereo_balance_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.75"
                            android:text="@string/stereo_balance_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_stereo_balance_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Center"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_stereo_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="-100"
                    android:valueTo="100"
                    app:tickVisible="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
